{
  "name": "kairo",
  "productName": "Kairo",
  "version": "1.7.4",
  "description": "A desktop companion for Windows: chat and talk hands-free with Claude, GPT or Gemini, let it look at your screen, explore the Earth, play chess, set reminders and control your PC from your phone.",
  "author": "Kairo contributors",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "electron scripts/make-icon.js",
    "shortcut": "powershell -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [
    "electron",
    "ai",
    "assistant",
    "desktop",
    "claude",
    "openai",
    "gemini",
    "voice",
    "chess"
  ],
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "lucide-static": "^0.460.0"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "chess.js": "^1.4.0",
    "discord.js": "^14.16.3",
    "electron-updater": "^6.3.9",
    "globe.gl": "^2.46.2",
    "imapflow": "^1.7.8",
    "mailparser": "^3.12.4",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "satellite.js": "^5.0.0",
    "stockfish": "^10.0.2",
    "three": "^0.149.0",
    "unpdf": "^0.12.1"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "app.kairo.desktop",
    "productName": "Kairo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/canvas/**"
    ],
    "asarUnpack": [
      "node_modules/stockfish/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kairo",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Kairo-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "eronrexhepi1234-tech",
        "repo": "kairo",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eronrexhepi1234-tech/kairo.git"
  },
  "homepage": "https://github.com/eronrexhepi1234-tech/kairo"
}
